ize</code> and <code>maxSize</code> to reflect the <code>z</code> value of each bubble. Can be either pixels (when no unit is given), or a percentage of the smallest one of the plot width and height. ","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/bubble-size/\" target=\"_blank\">Bubble size</a>","deprecated":false,"fullname":"plotOptions.bubble.maxSize","title":"maxSize","parent":"plotOptions-bubble","isParent":false,"products":[],"defaults":"20%","values":"","seeAlso":""},{"name":"xAxis-labels--maxStaggerLines","returnType":"Number","since":"3.0.3","description":"Horizontal axis only. When <code>staggerLines</code> is not set, <code>maxStaggerLines</code> defines how many lines the axis is allowed to add to automatically avoid overlapping X labels. Set to <code>1</code> to disable overlap detection. ","deprecated":true,"fullname":"xAxis.labels.maxStaggerLines","title":"maxStaggerLines","parent":"xAxis-labels","isParent":false,"products":[],"defaults":"5"},{"name":"yAxis-labels--maxStaggerLines","returnType":"Number","since":"3.0.3","description":"Horizontal axis only. When <code>staggerLines</code> is not set, <code>maxStaggerLines</code> defines how many lines the axis is allowed to add to automatically avoid overlapping X labels. Set to <code>1</code> to disable overlap detection. ","deprecated":true,"fullname":"yAxis.labels.maxStaggerLines","title":"maxStaggerLines","parent":"yAxis-labels","isParent":false,"products":[],"defaults":"5"},{"name":"zAxis-labels--maxStaggerLines","returnType":"Number","since":"3.0.3","description":"Horizontal axis only. When <code>staggerLines</code> is not set, <code>maxStaggerLines</code> defines how many lines the axis is allowed to add to automatically avoid overlapping X labels. Set to <code>1</code> to disable overlap detection. ","deprecated":true,"fullname":"zAxis.labels.maxStaggerLines","title":"maxStaggerLines","parent":"zAxis-labels","isParent":f