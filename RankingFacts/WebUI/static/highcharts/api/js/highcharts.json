offline.highcharts.object = [{"name":"Axis","returnType":"","since":"","description":"<p>A chart can have from 0 axes (pie chart) to multiples. In a normal, single series cartesian chart, there is one X axis and one Y axis.</p><p>The X axis or axes are referenced by <code>chart.xAxis</code>, which is an array of Axis objects. If there is only one axis, it can be referenced through <code>chart.xAxis[0]</code>, and multiple axes have increasing indices. The same pattern goes for Y axes.</p><p>If you need to get the axes from a series object, use the <code>series.xAxis</code> and<code>series.yAxis</code> properties. These are not arrays, as one series can only be associated to one X and one Y axis.</p><p>A third way to reference the axis programmatically is by id. Add an id in the axis configuration options, and get the axis by <code>chart.get(id)</code>.</p> <p>Configuration options for the axes are given in <a class=\"internal\" href=\"#xAxis\">options.xAxis</a> and <a class=\"internal\" href=\"#yAxis\">options.yAxis</a>.</p>","demo":"","deprecated":false,"fullname":"Axis","title":"Axis","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Axis--remove","returnType":"","since":"3.0","description":"Remove an axis from the chart.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-addaxis/\" target=\"_blank\">Add and remove axes</a>","deprecated":false,"fullname":"Axis.remove","title":"remove","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Boolean redraw)","paramsDescription":"redraw: Boolean<br>\r\nDefaults to <code>true</code>. Whether to redraw the chart following the remove. "},{"name":"Axis--removePlotBand","returnType":"","since":"1.2.0","description":"Remove a plot band by its <code>id</code>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-removeplotband/\" target=\"_blank\">Remove plot band by id</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-addplotband/\" target=\"_blank\">Toggle the plot band from a button</a>","deprecated":false,"fullname":"Axis.removePlotBand","title":"removePlotBand","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(String id)","paramsDescription":"id: String<br>The plot band's <code>id</code> as given in the original configuration object or in the addPlotBand method."},{"name":"Axis--removePlotLine","returnType":"","since":"1.2.0","description":"Remove a plot line by its <code>id</code>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/xaxis/plotlines-id/\" target=\"_blank\">Remove plot line by id</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-addplotline/\" target=\"_blank\">toggle the plot line from a button</a>","deprecated":false,"fullname":"Axis.removePlotLine","title":"removePlotLine","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(String id)","paramsDescription":"id: String<br>The plot line's <code>id</code> as given in the original configuration object or in the addPlotLine method."},{"name":"Axis--setCategories","since":"1.2.0","description":"Set new categories for the axis.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-setcategories/\" target=\"_blank\">Set categories by click on a button</a>","fullname":"Axis.setCategories","title":"setCategories","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Array cateories, [Boolean redraw])","paramsDescription":"categories: Array<br>The new category names.||redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the axis or wait for an explicit call to <code>chart.redraw()</code>."},{"name":"Axis--setExtremes","returnType":"","since":"1.2.0","description":"Set the minimum and maximum of the axes after render time. If the <code>startOnTick</code> and <code>endOnTick</code> options are true, the minimum and maximum values are rounded off to the nearest tick. To prevent this, these options can be set to false before calling setExtremes. Also, <code>setExtremes</code> will not allow a range lower than the <a href=\"#xAxis.minRange\">minRange</a> option, which by default is the range of five points.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-setextremes/\" target=\"_blank\">Set extremes from button</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-setextremes-datetime/\" target=\"_blank\">Set extremes on datetime axis</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-setextremes-off-ticks/\" target=\"_blank\">setting extremes off ticks</a>","deprecated":false,"fullname":"Axis.setExtremes","title":"setExtremes","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Number min, Number max, [Boolean redraw], [Mixed animation])","paramsDescription":"min: Number<br>The new minimum value||max: Number<br>The new maximum value||redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart or wait for an explicit call to <code>chart.redraw()</code>.||animation: Mixed<br>Defaults to true. When true, the resize will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Axis--toPixels","returnType":"Number","since":"3.0","description":"Translates a value in terms of axis units in to pixels within the chart.","demo":"","deprecated":false,"fullname":"Axis.toPixels","title":"toPixels","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Number value, [Boolean paneCoordinates])","paramsDescription":"value: Number<br>\r\nA value in terms of axis units.||\r\n\r\npaneCoordinates: Boolean<br>\r\nWhether to return the pixel coordinate relative to the chart or just the axis/pane itself."},{"name":"Axis--toValue","returnType":"Number","since":"3.0","description":"Translate a pixel position along the axis to a value in terms of axis units.","demo":"","deprecated":false,"fullname":"Axis.toValue","title":"toValue","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Number pixel, [Boolean paneCoordinates])","paramsDescription":"pixel: Number<br>\r\nA pixel position along the axis.||\r\n\r\npaneCoordinates: Boolean<br>\r\nWhether the input pixel position is relative to the chart or just the axis/pane itself."},{"name":"Axis--update","returnType":"","since":"3.0","description":"Update an axis object with a new set of options. The options are merged with the existing options, so only new or altered options need to be specified.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-update/\" target=\"_blank\">Axis update demo</a>","deprecated":false,"fullname":"Axis.update","title":"update","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Object options, [Boolean redraw])","paramsDescription":"options: Object<br>\r\nThe new options that will be merged in with existing options on the axis.||\r\n\r\nredraw: Boolean<br>\r\nDefaults to <code>true</code>. Whether to redraw the chart after the new options are set. "},{"name":"Chart","returnType":"","since":"","description":"<p>The chart object is the JavaScript object representing a single chart in the web page.The pointer to your chart object is returned when a chart is created using the <code>Highcharts.Chart()</code> constructor:</p><pre>var chart1 = new Highcharts.Chart(options);</pre>","demo":"","deprecated":false,"fullname":"Chart","title":"Chart","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Chart--addAxis","returnType":"","since":"3.0","description":"Add an axis to the chart after render time. Note that this method should never be used when adding data synchronously at chart render time, as it adds expense to the calculations and rendering. When adding data at the same time as the chart is initiated, add the axis as a configuration option instead.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-addaxis/\" target=\"_blank\">Add and remove axes</a>","deprecated":false,"fullname":"Chart.addAxis","title":"addAxis","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object options, [Boolean isX], [Boolean redraw], [Mixed animation])","paramsDescription":"options: Object<br>\r\nThe Axis options, as documented under <a href=\"#xAxis\">xAxis</a> and <a href=\"#yAxis\">yAxis</a>.||\r\n\r\nisX: Boolean<br>\r\nWhether it is an X axis or Y axis.||\r\n\r\nredraw: Boolean<br>\r\nDefaults to <code>true</code>. Whether to redraw the chart after the series is added. See the <code>redraw()</code> method below.||\r\n\r\nanimation: Mixed<br>\r\nDefaults to true. When true, the series' updating will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Chart--exportChart","returnType":"","since":"2.0","description":"Exporting module required. Submit an SVG version of the chart to a server along with some parameters for conversion.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-exportchart/\" target=\"_blank\">Export with no options</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-exportchart-filename/\" target=\"_blank\">PDF type and custom filename</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-exportchart-custom-background/\" target=\"_blank\">different chart background in export</a>","deprecated":false,"fullname":"Chart.exportChart","title":"exportChart","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object options, Object chartOptions)","paramsDescription":"options: Object<br>Exporting options. Out of the <a class=\"internal\" href=\"#exporting\">exporting</a> options, the following options can be given as parameters to the exportChart method. All options default to the values given in the exporting config options. \r\n<code>filename</code>: the filename for the export without extension, \r\n<code>url</code>: the URL for the server module to do the conversion, \r\n<code>width</code>: the width of the PNG or JPEG image generated on the server, \r\n<code>type</code>: the MIME type of the converted image, \r\n<code>sourceWidth</code>: the width of the source (in-page) chart, \r\n<code>sourceHeight</code>: the height of the source chart.||\r\n\r\nchartOptions: Object<br>Additional chart options for the exported chart. For example a different background color can be added here."},{"name":"Chart--getSVG","returnType":"String","since":"2.0","description":"Exporting module required. Get an SVG string representing the chart.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-getsvg/\" target=\"_blank\">View the SVG from a button</a>","deprecated":false,"fullname":"Chart.getSVG","title":"getSVG","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object additionalOptions)","paramsDescription":"additionalOptions: Object<br>Chart options to add to the exported chart in addition to the options given for the original chart. For example if series.lineWidth should be greater in the exported chart than in the original, or the chart should have a different background color, this is added here."},{"name":"Chart--getSelectedPoints","returnType":"Array<Point>","since":"1.2.0","description":"Returns an array of all currently selected points in the chart. Points can be selected either programmatically by the <code>point.select()</code> method or by clicking.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-allowpointselect-line/\" target=\"_blank\">Get selected points</a>","deprecated":false,"fullname":"Chart.getSelectedPoints","title":"getSelectedPoints","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":"An array of the selected points."},{"name":"Chart--destroy","returnType":"","since":"1.2.2","description":"Removes the chart and purges memory. This method should be called before writing a new chart into the same container. It is called internally on window unload to prevent leaks.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-destroy/\" target=\"_blank\">Destroy the chart from a button</a>","deprecated":false,"fullname":"Chart.destroy","title":"destroy","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Chart--options","returnType":"Object","since":"1.2.0","description":"The options structure for the chart.","demo":"","deprecated":false,"fullname":"Chart.options","title":"options","parent":"Chart","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Chart--xAxis","returnType":"Array<Axis>","since":"1.2.0","description":"An array of the chart's x axes. If only one x axis, it is referenced by <code>chart.xAxis[0]</code>.","demo":"","deprecated":false,"fullname":"Chart.xAxis","title":"xAxis","parent":"Chart","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Chart--yAxis","returnType":"Array<Axis>","since":"1.2.0","description":"An array of the chart's y axes. If only one y axis, it is referenced by <code>chart.yAxis[0]</code>.","demo":"","deprecated":false,"fullname":"Chart.yAxis","title":"yAxis","parent":"Chart","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Chart--container","returnType":"Object","since":"1.2.5","description":"A reference to the containing HTML element, dynamically inserted into the element given in <code>chart.renderTo</code>.","demo":"","deprecated":false,"fullname":"Chart.container","title":"container","parent":"Chart","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Point--series","returnType":"Series","since":"1.2.0","description":"The series object associated with the point.","demo":"","deprecated":false,"fullname":"Point.series","title":"series","parent":"Point","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Renderer--text","returnType":"Element","since":"2.0","description":"Draw text. The text can contain a subset of HTML, like spans and anchors and some basic text styling of these. For more advanced features like border and background, use <a href=\"#Renderer.label\">label</a> instead. To update the text after render, run <code>Element.attr({ text: 'New text' })</code>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-text-on-chart/\" target=\"_blank\">Annotate the chart freely</a>; <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-on-chart/\" target=\"_blank\">annotate with a border and in response to the data</a>; <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-text/\" target=\"_blank\">formatted text</a>.","deprecated":false,"fullname":"Renderer.text","title":"text","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(String str, Number x, Number y)","paramsDescription":"str: String<br>The text or HTML to draw||x: Number<br>The x position of the text's lower left corner.||y: Number<br>The y position of the text's lower left corner."},{"name":"Chart--subtitle","returnType":"","since":"","description":"","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/title-update/\" target=\"_blank\">Updating titles</a>.","deprecated":false,"fullname":"Chart.subtitle","title":"subtitle","parent":"Chart","isParent":false,"products":[],"type":"","params":"","paramsDescription":"The chart subtitle. The subtitle has an <code>update</code> method that allows modifying the options."},{"name":"Chart--print","returnType":"","since":"2.0","description":"Exporting module required. Clears away other elements in the page and prints the chart as it is displayed. By default, when the exporting module is enabled, a button at the upper left calls this method.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-print/\" target=\"_blank\">Print from a HTML button</a>","deprecated":false,"fullname":"Chart.print","title":"print","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Chart--showLoading","returnType":"null","since":"2.0.5","description":"Dim the chart's plot area and show a loading label text. Options for the loading screen are defined at <a class=\"internal\" href=\"#loading\">options.loading</a>. A custom text can be given as a parameter for loading.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-hideloading/\" target=\"_blank\">Show and hide loading from a button</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-showloading/\" target=\"_blank\">apply different text labels.</a>","deprecated":false,"fullname":"Chart.showLoading","title":"showLoading","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(String str)","paramsDescription":""},{"name":"Chart--updatePosition","returnType":"","since":"1.2.5","description":"This method is deprecated as of 2.0.1. Updating the chart position after a move operation is no longer necessary.","demo":"","deprecated":true,"fullname":"Chart.updatePosition","title":"updatePosition","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Element","returnType":"","since":"","description":"<p>The Element class is a JavaScript wrapper for SVG elements used in the rendering layer of Highchart. Combined with the Renderer object, these elements allows freeform annotation in the charts or even in your HTML pages without creating a chart at all.</p>","demo":"","deprecated":false,"fullname":"Element","title":"Element","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Element--add","returnType":"Element","since":"2.0","description":"Add the element to the renderer canvas.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-g/\" target=\"_blank\">Elements added to a group</a>","fullname":"Element.add","title":"add","parent":"Element","isParent":false,"products":[],"type":"method","params":"[(Object parent)]","paramsDescription":"parent: Object<br>The element can be added to a <code>g</code> (group) element."},{"name":"Element--animate","returnType":"Element","since":"2.0","description":"Apply numeric attributes to the SVG/VML element by animation. See <a href=\"#Element.attr()\">Element.attr()</a> for more information on setting attributes.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/element-on/\" target=\"_blank\">Setting some attributes by animation</a>","deprecated":false,"fullname":"Element.animate","title":"animate","parent":"Element","isParent":false,"products":[],"type":"method","params":"(Object attributes, [Object animation])","paramsDescription":"attributes: Object<br/>A set of attributes to apply.||animation: Object<br/>Optional animation parameters that are passed over to jQuery or other framework. Valid properties depend on the library, but options like <code>duration</code>, <code>easing</code> and <code>complete</code> are supported by jQuery."},{"name":"Element--css","returnType":"Element","since":"2.0","description":"Apply some CSS properties to the element","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-text-on-chart/\" target=\"_blank\">Styled text</a>","deprecated":false,"fullname":"Element.css","title":"css","parent":"Element","isParent":false,"products":[],"type":"method","params":"(Object hash)","paramsDescription":"hash: Object<br>The object literal of CSS properties to apply. Properties should be camelCased, not hyphenated."},{"name":"Element--on","returnType":"Element","since":"2.0","description":"Apply an event handler to the element","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/element-on/\" target=\"_blank\">A clickable rectangle</a>.","fullname":"Element.on","title":"on","parent":"Element","isParent":false,"products":[],"type":"method","params":"(String eventType, Function handler)","paramsDescription":"eventType: String<br>The event type to attach, for example 'click', 'mouseover', 'touch'.||handler: Function<br>The event handler function."},{"name":"Element--toFront","returnType":"Element","since":"2.0","description":"Bring the element to the front. Alternatively, a zIndex attribute can be given.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/element-tofront/\" target=\"_blank\">Click an element to bring it to front</a>.","fullname":"Element.toFront","title":"toFront","parent":"Element","isParent":false,"products":[],"type":"method","paramsDescription":"The element object"},{"name":"Highcharts","returnType":"","since":"","description":"<p>The namespace under which all other Highcharts variables are assembled is called <code>Highcharts</code>. </p><pre>var chart1 = new Highcharts.Chart(options);</pre>","demo":"","deprecated":false,"fullname":"Highcharts","title":"Highcharts","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Highcharts--charts","returnType":"Array<Chart>","since":"2.3.4","description":"An array containing the current chart objects in the page. A chart's position in the array is preserved throughout the page's lifetime. When a chart is destroyed, the array item becomes <code>undefined</code>.","demo":"","deprecated":false,"fullname":"Highcharts.charts","title":"charts","parent":"Highcharts","isParent":false,"products":[],"type":"Array<Object>","params":"","paramsDescription":""},{"name":"Highcharts--dateFormat","returnType":"String","since":"","description":"Formats a JavaScript date timestamp (milliseconds since Jan 1st 1970) into a human readable date string. The format is a subset of the formats for <a href=\"http://php.net/manual/en/function.strftime.php\">PHP's strftime function</a>. Additional formats can be given  in the Highcharts.dateFormats hook, see below.","demo":"","deprecated":false,"fullname":"Highcharts.dateFormat","title":"dateFormat","parent":"Highcharts","isParent":false,"products":[],"type":"method","params":"(String format, [Number time], [Boolean capitalize])","paramsDescription":"format: String<br>A string containing some of the formats above.||time: Number<br>The JavaScript time to format.||capitalize: Boolean<br>Whether to capitalize words in the return string."},{"name":"Highcharts--dateFormats","returnType":"","since":"3.0","description":"A hook for defining additional date format specifiers. New specifiers are defined as key-value pairs by using the specifier as key, and a function which takes the timestamp as value. This function returns the formatted portion of the date.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/global/dateformats/\" target=\"_blank\">Adding support for week number</a>","deprecated":false,"fullname":"Highcharts.dateFormats","title":"dateFormats","parent":"Highcharts","isParent":false,"products":[],"type":"Object","params":"","paramsDescription":""},{"name":"Highcharts--setOptions","returnType":"Object","description":"Sets the options globally for all charts created after this has been called. Takes an options JavaScript object structure as the argument. These options are merged with the default options and the result is returned.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/global/useutc-false/\" target=\"_blank\">Setting a global option</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/setoptions/\" target=\"_blank\">applying a general theme</a>","fullname":"Highcharts.setOptions","title":"setOptions","parent":"Highcharts","isParent":false,"products":[],"type":"method","params":"(Object options)","paramsDescription":"options: Object<br>The chart configuration object."},{"name":"Point","returnType":"","since":"","description":"<p>The Point object is the JavaScript representation of each data point</p><p>The object can be accessed in a number of ways. In all point event handlers the point object is <code>this</code>. In the <code>series</code> object all the points are accessed by the <code>series.data</code> array.</p><p>Another way to reference the point programmatically is by id. Add an id in the point configuration options, and get the point object by <code>chart.get(id)</code>.</p>","demo":"","deprecated":false,"fullname":"Point","title":"Point","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Point--percentage","returnType":"Number","since":"1.2.0","description":"The percentage for points in a stacked series or pies.","fullname":"Point.percentage","title":"percentage","parent":"Point","isParent":false,"products":[],"type":"property"},{"name":"Point--remove","returnType":"","since":"1.2.0","description":"Remove the point from the series.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-point-events-remove/\" target=\"_blank\">Remove point and confirm</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/point-remove/\" target=\"_blank\">Remove pie slice</a>","deprecated":false,"fullname":"Point.remove","title":"remove","parent":"Point","isParent":false,"products":[],"type":"method","params":"([Boolean redraw], [Mixed animation])","paramsDescription":"redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the point is removed.If doing more operations on the chart, it is a good idea to set redraw to false and call <code>chart.redraw()</code> after.||animation: Mixed<br>Defaults to true. When true, the graph's updating will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Point--selected","returnType":"Boolean","since":"1.2.0","description":"Whether the point is selected or not.","fullname":"Point.selected","title":"selected","parent":"Point","isParent":false,"products":[],"type":"property"},{"name":"Point--slice","returnType":"","since":"1.2.0","description":"Slice out or set back in a pie chart slice. This is the default way of Highcharts to visualize that a pie point is selected.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/point-slice/\" target=\"_blank\">Slice and unslice a point from a button</a>","deprecated":false,"fullname":"Point.slice","title":"slice","parent":"Point","isParent":false,"products":[],"type":"method","params":"([Boolean sliced], [Boolean redraw], [Mixed animation])","paramsDescription":"sliced: Boolean<br>When <code>true</code>, the point is sliced out. When <code>false</code>, the point is set in. When <code>null</code> or <code>undefined</code>, the sliced state is toggled.||redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the point is altered.||animation: Mixed<br>Defaults to true. When true, the move will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Point--x","returnType":"Number","since":"1.2.0","description":"The x value for the point.","fullname":"Point.x","title":"x","parent":"Point","isParent":false,"products":[],"type":"property"},{"name":"Point--y","returnType":"Number","since":"1.2.0","description":"The y value for the point.","fullname":"Point.y","title":"y","parent":"Point","isParent":false,"products":[],"type":"property"},{"name":"Renderer","returnType":"","since":"","description":"<p>Allows direct access to the Highcharts rendering layer in order to draw primitive shapes like circles, rectangles,paths or text directly on a chart, or independent from any chart. The Renderer represents a wrapper object for SVGin modern browsers and VML in IE &lt; 8.</p><p>An existing chart's renderer can be accessed through <code>chart.renderer</code>. To create a renderer independent from a chart, use <code>var renderer = new Highcharts.Renderer(parentNode, width, height);</code> where parentNode is the HTML element where you want to add it.</p><p>The Renderer's methods are chained wherever possible, so you can initiate an element then call for example <code>attr</code> and <code>css</code> and <code>add</code> on that element in one statement.</p><div class=\"demo\"><a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-on-chart/\">Annotating a chart programmatically</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-basic/\">independent SVG/VML drawing</a></div>","demo":"","deprecated":false,"fullname":"Renderer","title":"Renderer","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Renderer--arc","returnType":"Element","since":"2.0","description":"Draw an arc on the renderer canvas.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-arc/\" target=\"_blank\">Drawing an arc</a>","fullname":"Renderer.arc","title":"arc","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(Number centerX, Number centerY, Number outerRadius, Number innerRadius, Number start, Number end)","paramsDescription":"centerX: Number<br>The x position of the arc's center in the SVG element.||centerY: Number<br>The y position of the arc's center in the SVG element.||outerRadius: Number<br>The outer radius of the arc.||innerRadius: Number<br>The inner radius of the arc.||start: Number<br>The starting angle of the arc in radians, where 0 is to the right and -Math.PI/2 is up.||end: Number<br>The ending angle of the arc in radians, where 0 is to the right and -Math.PI/2 is up."},{"name":"Renderer--circle","returnType":"Element","since":"2.0","description":"Draw circle on the renderer canvas.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-circle/\" target=\"_blank\">Drawing a circle</a>","fullname":"Renderer.circle","title":"circle","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(Number centerX, Number centerY, Number radius)","paramsDescription":"centerX: Number<br>The x position of the circle's center in the SVG element.||centerY: Number<br>The y position of the circle's center in the SVG element.||radius: Number<br>The radius of the circle."},{"name":"Renderer--g","returnType":"Element","since":"2.0","description":"Add an SVG/VML group.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-g/\" target=\"_blank\">Show and hide grouped objects</a>","deprecated":false,"fullname":"Renderer.g","title":"g","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(String name)","paramsDescription":"name: String<br>The name of the group. This will be used in the class name, which will be <code>\"highcharts-\"+ name</code>. Other Element objects are added to the group by using the group as the first parameter in .add() for the wrappers."},{"name":"Renderer--image","returnType":"Element","since":"2.0","description":"Add an image from an external resource.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-image-on-chart/\" target=\"_blank\">Add an image in a chart</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-image/\" target=\"_blank\">add an image independent from chart</a>","fullname":"Renderer.image","title":"image","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(String source, Number x, Number y, Number width, Number height)","paramsDescription":"source: String<br>The URL of the image.||x: String<br>The x position of the image's upper left corner.||y: String<br>The y position of the image's upper left corner.||width: String<br>The width of the image.||height: String<br>The height of the image."},{"name":"Renderer--path","returnType":"Element","since":"2.0","description":"Add a path based on <a href=\"http://www.w3.org/TR/SVG/paths.html\">SVG's path commands</a>. In SVG capable browsers all path commands are supported, but in VML only a subset is supported: absolute moveTo (M), absolute lineTo (L), absolute curveTo (C) and close (Z).","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-path-on-chart/\" target=\"_blank\">Draw a path in a chart</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-path/\" target=\"_blank\">draw a path independent from a chart</a>","deprecated":false,"fullname":"Renderer.path","title":"path","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(Array path)","paramsDescription":"path: Array<br>An SVG path split up in array form."},{"name":"Renderer--rect","returnType":"Element","since":"2.0","description":"Add a rectangle.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-rect-on-chart/\" target=\"_blank\">Draw a rectangle in a chart</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-rect/\" target=\"_blank\">draw a rectangle independent from a chart</a>","fullname":"Renderer.rect","title":"rect","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(Number x, Number y, Number width, Number height, Number cornerRadius)","paramsDescription":"x: Number<br>The x position of the rectangle's upper left corner.||y: Number<br>The y position of the rectangle's upper left corner.||width: Number<br>The width of the rectangle.||height: Number<br>The height of the rectangle.||cornerRadius: Number<br>The corner radius of all the rectangle's corners."},{"name":"Series","returnType":"","since":"","description":"<p>The Series object is the JavaScript representation of each line, area series, pie etc.</p><p>The object can be accessed in a number of ways. All series and point event handlers give a reference to the series object. The <code>chart</code> object has a <code>series</code> property that is a collection of all the chart's series. The <code>point</code> objects also have the same reference.</p><p>Another way to reference the series programmatically is by id. Add an id in the series configuration options, and get the series object by <code>chart.get(id)</code>.</p><p>Configuration options for the series are given in three levels. Options for all series in a chart are given in the <a class=\"internal\" href=\"#plotOptions.series\">plotOptions.series</a> object. Then options for all series of a specific type are given in the plotOptions of that type, for example plotOptions.line. Next, options for one single series are given in <a class=\"internal\" href=\"#series\">the series array</a>.</p>","demo":"","deprecated":false,"fullname":"Series","title":"Series","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Series--addPoint","returnType":"","since":"1.2.0","description":"Add a point to the series after render time. The point can be added at the end, or by giving it an X value, to the start or in the middle of the series.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-addpoint-append/\" target=\"_blank\">Append point</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-addpoint-append-and-shift/\" target=\"_blank\">append and shift</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-addpoint-x-and-y/\" target=\"_blank\">both x and y values given</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-addpoint-pie/\" target=\"_blank\">append pie slice</a>","deprecated":false,"fullname":"Series.addPoint","title":"addPoint","parent":"Series","isParent":false,"products":[],"type":"method","params":"(Object options, [Boolean redraw], [Boolean shift], [Mixed animation])","paramsDescription":"options: Number|Array|Object<br>The point options. If options is a single number, a point with that y value is appended to the series.If it is an array, it will be interpreted as x and y values respectively. If it is an object, advanced options as outlined under <a class=\"internal\" href=\"#series.data\">series.data</a> are applied.||\r\nredraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the point is added. When adding more than one point, it is highly recommended that the <code>redraw</code> option be set to false, and instead <code>chart.redraw()</code> is explicitly called after the adding of points is finished.||\r\nshift: Boolean<br>Defaults to <code>false</code>. When shift is true, one point is shifted off the start of the series as one is appended to the end. Use this option for live charts monitoring a value over time.||animation: Mixed<br>Defaults to true. When true, the graph will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Series--name","returnType":"String","since":"1.2.0","description":"The series' name as given in the options.","fullname":"Series.name","title":"name","parent":"Series","isParent":false,"products":[],"type":"property"},{"name":"Series--options","returnType":"Object","since":"1.2.0","description":"Read only. The series' options.","fullname":"Series.options","title":"options","parent":"Series","isParent":false,"products":[],"type":"property"},{"name":"Series--select","returnType":"","since":"1.2.0","description":"Select or unselect the series. This means its <code>selected</code> property is set,the checkbox in the legend is toggled and when selected, the series is returned in the <code>chart.getSelectedSeries()</code> method.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-select/\" target=\"_blank\">Select a series from a button</a>","deprecated":false,"fullname":"Series.select","title":"select","parent":"Series","isParent":false,"products":[],"type":"method","params":"([Boolean|null selected])","paramsDescription":"selected: Boolean|null<br>When <code>true</code>, the series is selected. When <code>false</code> it is unselected. When <code>null</code> or <code>undefined</code>, the series' selection state is toggled."},{"name":"Series--selected","returnType":"Boolean","since":"1.2.0","description":"Read only. The series' selected state as set by <code>series.select()</code>.","fullname":"Series.selected","title":"selected","parent":"Series","isParent":false,"products":[],"type":"property"},{"name":"Series--setVisible","returnType":"","since":"","description":"A utility function to show or hide the series with an optional redraw.","demo":"","deprecated":false,"fullname":"Series.setVisible","title":"setVisible","parent":"Series","isParent":false,"products":[],"type":"method","params":"(Boolean visible, [Boolean redraw])","paramsDescription":"visible: Boolean<br>Whether to show or hide the series. If undefined, the visibility is toggled.||redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the series is altered.If doing more operations on the chart, it is a good idea to set redraw to false and call <code>chart.redraw()</code> after."},{"name":"Series--show","since":"1.2.0","description":"Shows the series if hidden.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-hide/\" target=\"_blank\">Toggle visibility from a button</a>","fullname":"Series.show","title":"show","parent":"Series","isParent":false,"products":[],"type":"method","params":"()"},{"name":"Series--type","returnType":"String","since":"1.2.0","description":"Read only. The series' type, like \"line\", \"area\" etc.","fullname":"Series.type","title":"type","parent":"Series","isParent":false,"products":[],"type":"property"},{"name":"Series--update","returnType":"","since":"3.0","description":"Update the series with a new set of options. For a clean and precise handling of new options, all methods and elements from the series are removed, and it is initiated from scratch. Therefore, this method is more performance expensive than some other utility methods like <code>setData</code> or <code>setVisible</code>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-update/\" target=\"_blank\">Updating series options</a>","deprecated":false,"fullname":"Series.update","title":"update","parent":"Series","isParent":false,"products":[],"type":"method","params":"(Object options, [Boolean redraw])","paramsDescription":"options: Boolean<br>\r\nNew options that will be merged into the series' existing options.\r\n\r\n||\r\n\r\nredraw: Boolean<br>\r\nDefaults to <code>true</code>. Whether to redraw the chart after the series is altered. If doing more operations on the chart, it is a good idea to set redraw to false and call <code>chart.redraw()</code> after."},{"name":"Series--visible","returnType":"Boolean","since":"1.2.0","description":"Read only. The series' visibility state as set by <code>series.show()</code>, <code>series.hide()</code>, or the initial configuration.","fullname":"Series.visible","title":"visible","parent":"Series","isParent":false,"products":[],"type":"property"},{"name":"Chart--addSeriesAsDrilldown","returnType":"","since":"3.0.8","description":"Add a series to the chart as drilldown from a specific point in the parent series. This method is used for async drilldown, when clicking a point in a series should result in loading and displaying a more high-resolution series. When <i>not</i> async, the setup is simpler using the <a href=\"#drilldown.series\">drilldown.series</a> options structure.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/drilldown/async/\" target=\"_blank\">Async drilldown</a>","deprecated":false,"fullname":"Chart.addSeriesAsDrilldown","title":"addSeriesAsDrilldown","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object point, Object seriesOptions)","paramsDescription":"point: Object<br>\r\nThe existing Point object from which the drilldown will start.||\r\n\r\nseriesOptions: Object<br>\r\nThe series options, as documented under <a href=\"#plotOptions.series\">plotOptions.series</a> and under the plotOptions for each series type."},{"name":"Chart--drillUp","returnType":"","since":"3.0.8","description":"When the chart is drilled down to a child series, calling <code>chart.drillUp()</code> will drill up to the parent series.","demo":"","deprecated":false,"fullname":"Chart.drillUp","title":"drillUp","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Chart--setTitle","returnType":"","since":"2.1.0","description":"Set a new title or subtitle for the chart.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-settitle/\" target=\"_blank\">Set title text and styles</a>","deprecated":false,"fullname":"Chart.setTitle","title":"setTitle","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object title, object subtitle, Boolean redraw)","paramsDescription":"title: Object<br>A configuration object for the new title as defined at <a class=\"internal\" href=\"#title\">#title</a>.||\r\nsubtitle: Object<br>A configuration object for the new subtitle as defined at <a class=\"internal\" href=\"#subtitle\">#subtitle</a>.||\r\nredraw: Boolean<br>Whether to redraw the chart. Defaults to true."},{"name":"Element--attr","returnType":"Element","since":"2.0","description":"<p>Apply attributes to the SVG/VML elements. These attributes for the most parts correspond to SVG, but some are specific to Highcharts, like <code>zIndex</code> and <code>rotation</code>.</p>\r\n\r\n<p>In order to set the rotation center for <code>rotation</code>, set x and y to 0 and use <code>translateX</code> and <code>translateY</code> attributes to position the element instead.</p>\r\n\r\n<p>Attributes frequently used in Highcharts are <code>fill</code>, <code>stroke</code>, <code>stroke-width</code>.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-rect/\" target=\"_blank\">Setting some attributes</a>","deprecated":false,"fullname":"Element.attr","title":"attr","parent":"Element","isParent":false,"products":[],"type":"method","params":"Object hash","paramsDescription":"hash: Object<br>A set of attributes to apply."},{"name":"Axis--setTitle","returnType":"","since":"2.2","description":"Update the title of the axis after render time.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-settitle/\" target=\"_blank\">Set a new Y axis title</a>","deprecated":false,"fullname":"Axis.setTitle","title":"setTitle","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Object title, [Boolean redraw])","paramsDescription":"title: Object<br>The new title options on the same format as given in <a class=\"internal\" href=\"#xAxis.title\">xAxis.title</a>.||redraw: Boolean<br>Whether to redraw the chart now or hold until the next chart.redraw()"},{"name":"Series--remove","returnType":"","since":"1.2.0","description":"Remove the series from the chart.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-remove/\" target=\"_blank\">Remove first series from a button</a>","deprecated":false,"fullname":"Series.remove","title":"remove","parent":"Series","isParent":false,"products":[],"type":"method","params":"([Boolean redraw])","paramsDescription":"redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the series is removed.If doing more operations on the chart, it is a good idea to set redraw to false and call <code>chart.redraw()</code> after."},{"name":"Chart--getSelectedSeries","returnType":"Array<Series>","since":"1.2.0","description":"Returns an array of all currently selected series in the chart. Series can be selected either programmatically by the <code>series.select()</code> method or by checking the checkbox next to the legend item if <code>series.showCheckBox</code> is true.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-getselectedseries/\" target=\"_blank\">Get selected series</a>","deprecated":false,"fullname":"Chart.getSelectedSeries","title":"getSelectedSeries","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":"An array of the selected Series items."},{"name":"Point--category","returnType":"String|Number","since":"1.2.0","description":"For categorized axes this property holds the category name for the point. For other axis it holds the x value.","demo":"","deprecated":false,"fullname":"Point.category","title":"category","parent":"Point","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Chart--hideLoading","returnType":"","since":"1.2.0","description":"Hide the loading screen. Options for the loading screen are defined at <a class=\"internal\" href=\"#loading\">options.loading</a>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-hideloading/\" target=\"_blank\">Show and hide loading from a button</a>","deprecated":false,"fullname":"Chart.hideLoading","title":"hideLoading","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Axis--addPlotLine","returnType":"","since":"1.2.0","description":"Add a plot line after render time.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-addplotline/\" target=\"_blank\">Toggle the plot line from a button</a>","deprecated":false,"fullname":"Axis.addPlotLine","title":"addPlotLine","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Object options)","paramsDescription":"options: Object<br>A configuration object consisting of the same members as <a class=\"internal\" href=\"#xAxis.plotLines\">options.xAxis.plotLines</a>"},{"name":"Axis--addPlotBand","returnType":"","since":"1.2.0","description":"Add a plot band after render time.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-addplotband/\" target=\"_blank\">Toggle the plot band from a button</a>","deprecated":false,"fullname":"Axis.addPlotBand","title":"addPlotBand","parent":"Axis","isParent":false,"products":[],"type":"method","params":"(Object options)","paramsDescription":"options: Object<br>A configuration object consisting of the same members as <a class=\"internal\" href=\"#xAxis.plotBands\">options.xAxis.plotBands</a>"},{"name":"Chart--series","returnType":"Array<Series>","since":"1.2.0","description":"An array of all the chart's series.","demo":"","deprecated":false,"fullname":"Chart.series","title":"series","parent":"Chart","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Element--destroy","returnType":"","since":"2.0","description":"Destroy the element and free up memory","demo":"","deprecated":false,"fullname":"Element.destroy","title":"destroy","parent":"Element","isParent":false,"products":[],"type":"method","params":"","paramsDescription":""},{"name":"Point--total","returnType":"Number","since":"","description":"The total of a stack for stacked series, or pie in pie charts.","demo":"","deprecated":false,"fullname":"Point.total","title":"total","parent":"Point","isParent":false,"products":[],"type":"Number","params":"","paramsDescription":""},{"name":"Chart--reflow","returnType":"","since":"","description":"Reflows the chart to its container. By default, the chart reflows automatically to its container following a <code>window.resize</code> event, as per the <a href=\"#chart.reflow\">chart.reflow</a> option. However, there are no reliable events for div resize, so if the container is resized without a window resize event, this must be called explicitly. ","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-reflow/\" target=\"_blank\">Resize div and reflow</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/chart/events-container/\" target=\"_blank\">pop up and reflow</a>","deprecated":false,"fullname":"Chart.reflow","title":"reflow","parent":"Chart","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Element--getBBox","returnType":"Object","since":"2.0","description":"Get the bounding box of the element","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-on-chart/\" target=\"_blank\">Draw a rectangle based on a text's bounding box</a>.","deprecated":false,"fullname":"Element.getBBox","title":"getBBox","parent":"Element","isParent":false,"products":[],"type":"method","params":"","paramsDescription":"A hash object containing x, y, width and height values for the element."},{"name":"Series--chart","returnType":"Chart","since":"1.2.0","description":"Read only. The chart that the series belongs to.","demo":"","deprecated":false,"fullname":"Series.chart","title":"chart","parent":"Series","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Series--data","returnType":"Array<Point>","since":"1.2.0","description":"Read only. An array with the series' data point objects.","demo":"","deprecated":false,"fullname":"Series.data","title":"data","parent":"Series","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Series--xAxis","returnType":"Axis","since":"1.2.0","description":"Read only. The unique xAxis object associated with the series.","demo":"","deprecated":false,"fullname":"Series.xAxis","title":"xAxis","parent":"Series","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Series--yAxis","returnType":"Axis","since":"1.2.0","description":"Read only. The unique yAxis object associated with the series.","demo":"","deprecated":false,"fullname":"Series.yAxis","title":"yAxis","parent":"Series","isParent":false,"products":[],"type":"property","params":"","paramsDescription":""},{"name":"Series--removePoint","returnType":"","since":"4.1.0","description":"Remove a point from the series. Unlike the <a href=\"#Point.remove\">Point.remove</a> method, this can also be done on a point that is not instanciated because it is outside the view or subject to data grouping.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-removepoint/\" target=\"_blank\">Remove cropped point</a>","deprecated":false,"fullname":"Series.removePoint","title":"removePoint","parent":"Series","isParent":false,"products":[],"type":"method","params":"(Object index, [Boolean redraw], [Mixed animation])","paramsDescription":"index: Number<br>The index of the point in the data array.||\r\nredraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the point is added. When adding more than one point, it is highly recommended that the <code>redraw</code> option be set to false, and instead <code>chart.redraw()</code> is explicitly called after the adding of points is finished.||\r\nanimation: Mixed<br>Defaults to true. When true, the graph will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Highcharts--numberFormat","returnType":"String","since":"","description":"Formats a JavaScript number with grouped thousands, a fixed amount of decimals and an optional decimal point. It is a port of PHP's function with the same name. See <a href=\"http://php.net/manual/en/function.number-format.php\">PHP number_format</a> for a full explanation of the parameters.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/highcharts-numberformat/\" target=\"_blank\">Custom number format</a>","deprecated":false,"fullname":"Highcharts.numberFormat","title":"numberFormat","parent":"Highcharts","isParent":false,"products":[],"type":"method","params":"(Number number, [Number decimals], [String decimalPoint], [String thousandsSep])","paramsDescription":"number: Number<br>The raw number to format.||decimals: Number<br>The desired number of decimals.||decimalPoint: String<br>The decimal point. Defaults to \".\" or to the string specified globally in options.lang.decimalPoint.||thousandsSep: String<br>The thousands separator. Defaults to \" \" or to the string specified globally in options.lang.thousandsSep."},{"name":"Renderer--label","returnType":"Element","since":"","description":"Draw a label, which is an extended <code>text</code> element with support for border and background. Highcharts creates a <code>g</code> element with a <code>text</code> and a <code>path</code> or <code>rect</code> inside, to make it behave somewhat like a HTML <code>div</code>. Border and background are set through <code>stroke</code>, <code>stroke-width</code> and <code>fill</code> attributes using the <a href=\"#Element.attr\">attr</a> method. To update the text after render, run <code>Element.attr({ text: 'New text' })</code>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/renderer-label-on-chart/\" target=\"_blank\">A label on the chart</a>","deprecated":false,"fullname":"Renderer.label","title":"label","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(String str, Number x, Number y, String shape, Number anchorX, Number anchorY, Boolean useHTML, Boolean baseline, String className)","paramsDescription":"str: String<br>\r\nThe text or HTML to draw||\r\n\r\nx: Number<br>\r\nThe x position of the label's left side.||\r\n\r\ny: Number<br>\r\nThe y position of the label's top side or baseline, depending on the <code>baseline</code> parameter.||\r\n\r\nshape: String<br>\r\nThe shape of the label's border/background, if any. Defaults to <code>rect</code>.||\r\n\r\nanchorX: Number<br>\r\nIf the shape has a pointer, like the chevron on a callout shape, anchorX is the x position to point to.||\r\n\r\nanchorY: Number<br>\r\nIf the shape has a pointer, like the chevron on a callout shape, anchorY is the y position to point to.||\r\n\r\nuseHTML: Boolean<br>\r\nUse HTML to render the text of the label.||\r\n\r\nbaseline: Boolean<br>\r\nWhether the label should be vertically aligned by the text baseline, which makes it behave like the <code>text</code> element, or by the top left side, which makes it behave like a HTML <code>div</code>.||\r\n\r\nclassName: String<br>\r\nA class name for the <code>g</code> element surrounding the label.\r\n\r\n"},{"name":"Chart--redraw","returnType":"","since":"1.2.0","description":"Redraw the chart after changes have been done to the data or axis extremes. All methods for updating axes, series or points have a parameter for redrawing the chart. This is <code>true</code> by default. But in many cases you want to do more than one operation on the chart before redrawing, for example add a number of points. In those cases it is a waste of resources to redraw the chart for each new point added. So you add the points and call <code>chart.redraw()</code> after.","demo":"","deprecated":false,"fullname":"Chart.redraw","title":"redraw","parent":"Chart","isParent":false,"products":[],"type":"method","params":"([Mixed animation])","paramsDescription":"animation: Mixed<br>Defaults to true. When true, the update will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Point--update","returnType":"","since":"1.2.0","description":"Update the point with new values.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/point-update-column/\" target=\"_blank\">Update column value</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/point-update-pie/\" target=\"_blank\">update pie slice</a>","deprecated":false,"fullname":"Point.update","title":"update","parent":"Point","isParent":false,"products":[],"type":"method","params":"([Mixed options], [Boolean redraw], [Mixed animation])","paramsDescription":"options: Number|Array|Object<br>The point options. Point options are handled as described under the <code>series&lt;type&gt;.data</code> item for each series type. For example for a line series, if options is a single number, the point will be given that number as the main <code>y</code> value. If it is an array, it will be interpreted as x and y values respectively. If it is an object, advanced options are applied.\r\n\r\n||redraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the point is updated.If doing more operations on the chart, it is a good idea to set redraw to false and call <code>chart.redraw()</code> after.\r\n\r\n||animation: Mixed<br>Defaults to true. When true, the update will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Series--setData","returnType":"","since":"1.2.0","description":"<p>Apply a new set of data to the series and optionally redraw it. The new data array is passed by reference (except in case of <code>updatePoints</code>), and may later be mutated when updating the chart data.</p>\r\n\r\n<p>Note the difference in behaviour when setting the same amount of points, or a different amount of points, as handled by the <code>updatePoints</code> parameter. </p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-setdata/\" target=\"_blank\">Set new data from a button</a>,<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-setdata-pie/\" target=\"_blank\">set data in a pie</a>","deprecated":false,"fullname":"Series.setData","title":"setData","parent":"Series","isParent":false,"products":[],"type":"method","params":"(Array<Mixed> data, [Boolean redraw], [Mixed animation], [Boolean updatePoints])","paramsDescription":"data: Array&lt;Number&gt;|Array&lt;Array&gt;|Array&lt;Object&gt;<br>Takes an array of data in the same format as described under <code>series&lt;type&gt;data</code> for the given series type.||\r\n\r\nredraw: Boolean<br>Defaults to <code>true</code>. Whether to redraw the chart after the series is altered. If doing more operations on the chart, it is a good idea to set redraw to false and call <code>chart.redraw()</code> after.||\r\n\r\n\r\nanimation: Mixed<br>When the updated data is the same length as the existing data, points will be updated by default, and animation visualizes how the points are changed. Set false to disable animation, or a configuration object to set duration or easing.||\r\n\r\n\r\nupdatePoints: Boolean<br>When the updated data is the same length as the existing data, points will be updated instead of replaced. This allows updating with animation. In this case, the original array is not passed by reference. Set false to prevent."},{"name":"Point--select","returnType":"","since":"1.2.0","description":"Select or unselect the point.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/point-select/\" target=\"_blank\">Select a point from a button</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/chart/events-selection-points/\" target=\"_blank\">select a range of points through a drag selection</a>.","deprecated":false,"fullname":"Point.select","title":"select","parent":"Point","isParent":false,"products":[],"type":"method","params":"([Boolean select], [Boolean accumulate])","paramsDescription":"select: Boolean<br>When <code>true</code>, the point is selected. When <code>false</code>, the point is unselected. When <code>null</code> or <code>undefined</code>, the selection state is toggled.||accumulate: Boolean<br>When <code>true</code>, the selection is added to other selected points. When <code>false</code>, other selected points are deselected. Internally in Highcharts,selected points are accumulated on Control, Shift or Cmd clicking the point."},{"name":"Point--visible","returnType":"","since":"","description":"For certain series types, like pie. Whether the Point instance is visible.","demo":"","deprecated":false,"fullname":"Point.visible","title":"visible","parent":"Point","isParent":false,"products":[],"type":"Boolean","params":"","paramsDescription":""},{"name":"Highcharts--chart","returnType":"Chart","since":"4.2.0","description":"As <code>Highcharts.Chart</code>, but without need for the <code>new</code> keyword.","demo":"","deprecated":false,"fullname":"Highcharts.chart","title":"chart","parent":"Highcharts","isParent":false,"products":[],"type":"","params":"([String|Object renderTo], Object options, Function callback)","paramsDescription":""},{"name":"Highcharts--Chart","returnType":"Chart","since":"","description":"This is the constructor for creating a new chart object.","demo":"","deprecated":false,"fullname":"Highcharts.Chart","title":"Chart","parent":"Highcharts","isParent":false,"products":[],"type":"method","params":"([String|Object renderTo], Object options, Function callback)","paramsDescription":"renderTo: String|Object<br>The id or a reference to a DOM element where the chart should be rendered (since v4.2.0).||\r\n\r\n\r\noptions: Object<br>The chart options, as documented under the heading \"The options object\"in the left menu.||\r\n\r\ncallback: Function<br>A function to execute when the chart object is finished loading and rendering. Since v4.2.2, it also waits for images to be loaded, for example from point markers. In most cases the chart is built in one thread, but in Internet Explorer version 8 or less the chart is sometimes initiated before the document is ready, and in these cases the <code>chart</code> object will not be finished directly after calling<code>new Highcharts.Chart()</code>. As a consequence, code that relies on the newly built Chart object should always run in the callback. Defining a <code>chart.event.load</code> handler is equivalent."},{"name":"Chart--exportChartLocal","returnType":"","since":"","description":"Export the chart to a PNG or SVG without sending it to a server. Requires <code>modules/exporting.js</code> and <code>modules/offline-exporting.js</code>.","demo":"","deprecated":false,"fullname":"Chart.exportChartLocal","title":"exportChartLocal","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object options, Object chartOptions)","paramsDescription":"See <a href=\"#Chart.exportChart\">exportChart</a> for parameter description."},{"name":"Chart--addSeries","returnType":"Series","since":"1.2.0","description":"Add a series to the chart after render time. Note that this method should never be used when adding data synchronously at chart render time, as it adds expense to the calculations and rendering. When adding data at the same time as the chart is initiated, add the series as a configuration option instead. With multiple axes, the <a href=\"/highcharts#xAxis.offset\">offset</a> is dynamically adjusted.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-addseries/\" target=\"_blank\">Add a series from a button</a>","deprecated":false,"fullname":"Chart.addSeries","title":"addSeries","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object options, [Boolean redraw], [Mixed animation])","paramsDescription":"options: Object<br>\r\nThe series options, as documented under <a href=\"#plotOptions.series\">plotOptions.series</a> and under the plotOptions for each series type.||\r\n\r\nredraw: Boolean<br>\r\nDefaults to <code>true</code>. Whether to redraw the chart after the series is added. See the <code>redraw()</code> method below.||\r\n\r\nanimation: Mixed<br>\r\nDefaults to true. When true, the series' updating will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Axis--getExtremes","returnType":"Object","since":"1.2.0","description":"Get the current extremes for the axis. The returned object contains:\r\n\r\n<dl>\r\n  <dt>dataMax:</dt>\r\n  <dd>The maximum value of the axis' associated series.</dd>\r\n\r\n  <dt>dataMin:</dt>\r\n  <dd>The minimum value of the axis' associated series.</dd>\r\n\r\n  <dt>max:</dt>\r\n  <dd>The maximum axis value, either automatic or set manually. If the <code>max</code> option is not set, <code>maxPadding</code> is 0 and <code>endOnTick</code> is <code>false</code>, this value will be the same as <code>dataMax</code>.</dd>\r\n\r\n  <dt>min:</dt>\r\n  <dd>The minimum axis value, either automatic or set manually. If the <code>min</code> option is not set, <code>minPadding</code> is 0 and <code>startOnTick</code> is <code>false</code>, this value will be the same as <code>dataMin</code>.</dd>\r\n</dl>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/axis-getextremes/\" target=\"_blank\">Report extremes by click on a button</a>","deprecated":false,"fullname":"Axis.getExtremes","title":"getExtremes","parent":"Axis","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"Renderer--button","returnType":"Element","since":"","description":"Creates a button in the given location.","demo":"","deprecated":false,"fullname":"Renderer.button","title":"button","parent":"Renderer","isParent":false,"products":[],"type":"","params":"(String str, Number x, Number y, Function callback, Object normalState, Object hoverState, Object pressedState, Object disabledState, String shape)","paramsDescription":"str: String<br>\r\nThe text or HTML to draw||\r\n\r\nx: Number<br>\r\nThe x position of the button's left side.||\r\n\r\ny: Number<br>\r\nThe y position of the button's top side.||\r\n\r\ncallback: Function<br>\r\nThe function to execute on button click or touch.||\r\n\r\nnormalState: Object<br>\r\nSVG attributes for the normal state.||\r\n\r\nhoverState: Object<br>\r\nSVG attributes for the hovered state.||\r\n\r\npressedState: Object<br>\r\nSVG attributes for the pressed state.||\r\n\r\ndisabledState: Object<br>\r\nSVG attributes for the disabled state.||\r\n\r\nshape: String<br>\r\nThe shape of the button's border/background, if any. Defaults to <code>rect</code>.\r\n"},{"name":"Chart--setSize","returnType":"","since":"","description":"Resize the chart to a given width and height. In order to set the width only, the height argument can be skipped. To set the height only, pass <code>undefined</code> for the width.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-setsize-button/\" target=\"_blank\">Test resizing from buttons</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-setsize-jquery-resizable/\" target=\"_blank\">add a jQuery UI resizable</a>","deprecated":false,"fullname":"Chart.setSize","title":"setSize","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Number width, Number height, [Mixed animation])","paramsDescription":"width: Number<br>\r\nThe new pixel width of the chart. Since v4.2.6, the argument can be <code>undefined</code> in order to preserve the current value (when setting height only), or <code>null</code> to adapt to the width of the containing element.||\r\n\r\nheight: Number<br>\r\nThe new pixel height of the chart. Since v4.2.6, the argument can be <code>undefined</code> in order to preserve the current value, or <code>null</code> in order to adapt to the height of the containing element.||\r\n\r\nanimation: Mixed<br>\r\nDefaults to true. When true, the resize will be animated with default animation options. The animation can also be a configuration object with properties <code>duration</code> and <code>easing</code>."},{"name":"Chart--addCredits","returnType":"","since":"5.0.0","description":"Set a new credits label for the chart.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/credits/credits-update/\" target=\"_blank\">Add and update credits</a>.","deprecated":false,"fullname":"Chart.addCredits","title":"addCredits","parent":"Chart","isParent":false,"products":[],"type":"","params":"(Object options)","paramsDescription":"options: Object<br>A configuration object for the credits as defined at <a class=\"internal\" href=\"#credits\">credits</a>."},{"name":"Chart--title","returnType":"","since":"5.0.0","description":"The chart title. The title has an <code>update</code> method that points back to <a href=\"#Chart.setTitle\">Chart.setTitle</code>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/title-update/\" target=\"_blank\">Updating titles</a>.","deprecated":false,"fullname":"Chart.title","title":"title","parent":"Chart","isParent":false,"products":[],"type":"","params":"","paramsDescription":""},{"name":"Chart--credits","returnType":"","since":"5.0.0","description":"The chart's credits label. The label has an <code>update</code> method that allows setting new options as per <a href=\"#credits\">the credits option set</a>.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/credits/credits-update/\" target=\"_blank\">Add and update credits</a>.","deprecated":false,"fullname":"Chart.credits","title":"credits","parent":"Chart","isParent":false,"products":[],"type":"","params":"","paramsDescription":""},{"name":"Chart--update","returnType":"","since":"5.0.0","description":"<p>A generic function to update any element of the chart. Elements can be enabled and disabled, moved, re-styled, re-formatted etc.</p>\r\n<p>A special case is configuration objects that take arrays, for example <a href=\"#xAxis\">xAxis</a>, <a href=\"#yAxis\">yAxis</a> or <a href=\"#series\">series</a>. For these collections, an <code>id</code> option is used to map the new option set to an existing object. If an existing object of the same <code>id</code> is not found, the corresponding item is updated. So for example, running <code>chart.update</code> with a series item without an id, will cause the existing chart's series with the same index in the series array to be updated.</p>\r\n<p>See also <a href=\"#responsive\">the responsive option set</a>. Switching between <a href=\"#responsive.rules\">responsive.rules</a> basically runs <code>chart.update</code> under the hood.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/chart-update/\" target=\"_blank\">Update chart geometry</a>.\r\n\r\n\r\n","deprecated":false,"fullname":"Chart.update","title":"update","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(Object options, Boolean redraw)","paramsDescription":"options: Object<br>A configuration object for the new chart options as defined in the <em>options</em> section of the API.||\r\nredraw: Boolean<br>Whether to redraw the chart. Defaults to <code>true</code>."},{"name":"Legend","returnType":"","since":"5.0.0","description":"<p>The Legend object is available from <code>chart.legend</code>. Each chart has only one legend.</p>","demo":"","deprecated":false,"fullname":"Legend","title":"Legend","isParent":true,"products":[],"params":"","paramsDescription":""},{"name":"Legend--update","returnType":"","since":"5.0.0","description":"Update the legend with new options.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/legend/legend-update/\" target=\"_blank\">Legend update</a>","deprecated":false,"fullname":"Legend.update","title":"update","parent":"Legend","isParent":false,"products":[],"type":"metthod","params":"(Object options, [Boolean redraw])","paramsDescription":"options: Object<br>\r\nThe new legend options as documented under <a href=\"#legend\">legend</a>.||\r\nredraw: Boolean<br>\r\nWhether to redraw the chart. Defaults to <code>true</code>."},{"name":"Renderer--definition","returnType":"Element","since":"5.0.0","description":"<p><a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">Styled mode</a> only. A hook for adding general definitions to the SVG's <code>defs</code> tag. Definitions can be referenced from the CSS by its <code>id</code>. Read more in <a href=\"http://www.highcharts.com/docs/chart-design-and-style/gradients-shadows-and-patterns\">Gradients, shadows and patterns</a>.</p>\r\n\r\n<p>The definitions can also be added as configuration options, see <a href=\"#defs\">defs</a>.</p>","demo":"","deprecated":false,"fullname":"Renderer.definition","title":"definition","parent":"Renderer","isParent":false,"products":[],"type":"method","params":"(Object def)","paramsDescription":"def: Object<br>\r\nA serialized form of an SVG definition, including children. "},{"name":"Series--hide","returnType":"","since":"1.2.0","description":"Hides the series if visible. If the <code>chart.ignoreHiddenSeries</code> option is true, the chart is redrawn without this series.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/members/series-hide/\" target=\"_blank\">Toggle visibility from a button</a>","deprecated":false,"fullname":"Series.hide","title":"hide","parent":"Series","isParent":false,"products":[],"type":"method","params":"()","paramsDescription":""},{"name":"tooltip--date","returnType":"Object","description":"<p>For series on a datetime axes, the date format in the tooltip's header will by default be guessed based on the closest data points. This member gives the default string representations used for each unit. For an overview of the replacement codes, see <a href=\"#Highcharts.dateFormat\">dateFormat</a>.</p>\r\n\r\n<p>Defaults to:\r\n<pre>{\r\n    millisecond:\"%A, %b %e, %H:%M:%S.%L\",\r\n    second:\"%A, %b %e, %H:%M:%S\",\r\n    minute:\"%A, %b %e, %H:%M\",\r\n    hour:\"%A, %b %e, %H:%M\",\r\n    day:\"%A, %b %e, %Y\",\r\n    week:\"Week from %A, %b %e, %Y\",\r\n    month:\"%B %Y\",\r\n    year:\"%Y\"\r\n}</pre>\r\n</p>","deprecated":false,"fullname":"tooltip.dateTimeLabelFormats","title":"dateTimeLabelFormats","parent":"tooltip","isParent":false,"products":[]},{"name":"Highcharts--error","returnType":"","since":"5.0.6","description":"The error handler function. By default is provides error messages for debugging, with links to the descriptions on Highcharts website. This function can be redefined to catch errors in client applications.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highslide-software/highcharts.com/tree/master/samples/highcharts/chart/highcharts-error/\" target=\"_blank\">Custom error handler</a>.","deprecated":false,"fullname":"Highcharts.error","title":"error","parent":"Highcharts","isParent":false,"products":[],"type":"","params":"(Number|String code, Boolean fatal)","paramsDescription":"code: Number|String<br>The error code. If this is a number, the default error function prints a link to a human readable error code description according to <a href=\"https://github.com/highcharts/highcharts/blob/master/errors/errors.xml\">error definition file</a>. If it's a string, the description is printed in the console.||\r\nfatal: Boolean<br>Whether the error should stop execution."},{"name":"Chart--get","returnType":"Axis|Series|Point","since":"1.2.0","description":"Get an axis, series or point by its <code>id</code> as given in the configuration options. Returns <code>undefined</code> if no item is found.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-id/\" target=\"_blank\">Get series by id</a>","deprecated":false,"fullname":"Chart.get","title":"get","parent":"Chart","isParent":false,"products":[],"type":"method","params":"(String id)","paramsDescription":"id: String<br>The id of the axis, series or point to get."}];
