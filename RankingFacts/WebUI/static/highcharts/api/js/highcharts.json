-dataLabels--borderWidth","returnType":"Number","since":"2.2.1","description":"The border width in pixels for the data label.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-datalabels-box/\" target=\"_blank\">Data labels box options</a>","deprecated":false,"fullname":"plotOptions.arearange.dataLabels.borderWidth","title":"borderWidth","parent":"plotOptions-arearange-dataLabels","isParent":false,"products":[],"defaults":"0"},{"name":"plotOptions-solidgauge-dataLabels--borderWidth","returnType":"Number","since":"2.3.0","description":"The border width in pixels for the gauge data label.","demo":"","deprecated":false,"fullname":"plotOptions.solidgauge.dataLabels.borderWidth","title":"borderWidth","parent":"plotOptions-solidgauge-dataLabels","isParent":false,"products":[],"defaults":"1","seeAlso":""},{"name":"series<heatmap>-dataLabels--borderWidth","returnType":"Number","since":"2.2.1","description":"The border width in pixels for the data label.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-datalabels-box/\" target=\"_blank\">Data labels box options</a>","deprecated":false,"fullname":"series<heatmap>.dataLabels.borderWidth","title":"borderWidth","parent":"series<heatmap>-dataLabels","isParent":false,"products":[],"defaults":"0"},{"name":"plotOptions-columnrange--borderWidth","returnType":"Number","description":"<p>The width of the border surrounding each column or bar.</p>\r\n\r\n<p>In <a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">styled mode</a>, the stroke width can be set with the <code>.highcharts-point</code> rule.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/column-borderwidth/\" target=\"_blank\">2px black border</a>","deprecated":false,"fullname":"plotOptions.columnrange.borderWidth","title":"borderWidth","parent":"plotOptions-columnrange","isParent":false,"products":[],"defaults":"1"},{"name":"series<pie>--borderWidth","returnType":"Number","description":"<p>The width of the border surrounding each slice.</p>\r\n\r\n<p>When setting the border width to 0, there may be small gaps between the slices due to SVG antialiasing artefacts. To work around this, keep the border width at 0.5 or 1, but set the <code>borderColor</code> to <code>null</code> instead.</p>\r\n\r\n<p>In <a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">styled mode</a>, the border stroke width is given in the <code>.highcharts-point</code> class.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/pie-borderwidth/\" target=\"_blank\">3px border</a>.\r\n\r\n\r\n<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/css/pie-point/\">Styled mode</a>.","deprecated":false,"fullname":"series<pie>.borderWidth","title":"borderWidth","parent":"series<pie>","isParent":false,"products":[],"defaults":"1"},{"name":"zAxis-plotBands--borderWidth","returnType":"Number","description":"Border width for the plot band.  Also requires <code>borderColor</code> to be set.","deprecated":false,"fullname":"zAxis.plotBands.borderWidth","title":"borderWidth","parent":"zAxis-plotBands","isParent":false,"products":[],"defaults":"0"},{"name":"series<bar>-dataLabels--borderWidth","returnType":"Number","since":"2.2.1","description":"The border width in pixels for the data label.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-datalabels-box/\" target=\"_blank\">Data labels box options</a>","deprecated":false,"fullname":"series<bar>.dataLabels.borderWidth","title":"borderWidth","parent":"series<bar>-dataLabels","isParent":false,"products":[],"defaults":"0"},{"name":"plotOptions-column--borderWidth","returnType":"Number","description":"<p>The width of the border surrounding each column or bar.</p>\r\n\r\n<p>In <a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">styled mode</a>, the stroke width can be set with the <code>.highcharts-point</code> rule.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/column-borderwidth/\" target=\"_blank\">2px black border</a>","deprecated":false,"fullname":"plotOptions.column.borderWidth","title":"borderWidth","parent":"plotOptions-column","isParent":false,"products":[],"defaults":"1"},{"name":"chart-options3d-frame-bottom","returnType":"","since":"4.0","description":"The bottom of the frame around a 3D chart.","demo":"","deprecated":false,"fullname":"chart.options3d.frame.bottom","title":"bottom","parent":"chart-options3d-frame","isParent":true,"products":[],"defaults":"","values":"","seeAlso":""},{"name":"plotOptions-boxplot","returnType":"Object","since":"3.0","description":"A box plot is a convenient way of depicting groups of data through their five-number summaries: the smallest observation (sample minimum), lower quartile (Q1), median (Q2), upper quartile (Q3), and largest observation (sample maximum). ","deprecated":false,"fullname":"plotOptions.boxplot","title":"boxplot","parent":"plotOptions","isParent":true,"products":[]},{"name":"yAxis-breaks--breakSize","returnType":"Number","since":"4.1.0","description":"A number indicating how much space should be left between the start and the end of the break. The break size is given in axis units, so for instance on a <code>datetime</code> axis, a break size of 3600000 would indicate the equivalent of an hour.","deprecated":false,"fullname":"yAxis.breaks.breakSize","title":"breakSize","parent":"yAxis-breaks","isParent":false,"products":[],"defaults":"0"},{"name":"xAxis-breaks--breakSize","returnType":"Number","since":"4.1.0","description":"A number indicating how much space should be left between the start and the end of the break. The break size is given in axis units, so for instance on a <code>datetime</code> axis, a break size of 3600000 would indicate the equivalent of an hour.","deprecated":false,"fullname":"xAxis.breaks.breakSize","title":"breakSize","parent":"xAxis-breaks","isParent":false,"products":[],"defaults":"0"},{"name":"xAxis-breaks","returnType":"Array","since":"4.1.0","description":"An array defining breaks in the axis, the sections defined will be left out and all the points shifted closer to each other. Requires that the broken-axis.js module is loaded.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/axisbreak/break-simple/\" target=\"_blank\">Simple break</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/axisbreak/break-visualized/\" target=\"_blank\">advanced with callback</a>","deprecated":false,"fullname":"xAxis.breaks","title":"breaks","parent":"xAxis","isParent":true,"products":[]},{"name":"yAxis-breaks","returnType":"Array","since":"4.1.0","description":"An array defining breaks in the axis, the sections defined will be left out and all the points shifted closer to each other. Requires that the broken-axis.js module is loaded.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/axisbreak/break-simple/\" target=\"_blank\">Simple break</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/axisbreak/break-visualized/\" target=\"_blank\">advanced with callback</a>","deprecated":false,"fullname":"yAxis.breaks","title":"breaks","parent":"yAxis","isParent":true,"products":[]},{"name":"series<treemap>-states-hover--brightness","returnType":"Number","description":"<p>How much to brighten the point on interaction. Requires the main color to be defined in hex or rgb(a) format.</p>\r\n\r\n<p>In <a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">styled mode</a>, the hover brightening is by default replaced with a fill-opacity set in the <code>.highcharts-point:hover</code> rule.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/column-states-hover-brightness/\" target=\"_blank\">Brighten by 0.5</a>","deprecated":false,"fullname":"series<treemap>.states.hover.brightness","title":"brightness","parent":"series<treemap>-states-hover","isParent":false,"products":[],"defaults":"0.1"},{"name":"plotOptions-treemap-states-hover--brightness","returnType":"Number","description":"<p>How much to brighten the point on interaction. Requires the main color to be defined in hex or rgb(a) format.</p>\r\n\r\n<p>In <a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">styled mode</a>, the hover brightening is by default replaced with a fill-opacity set in the <code>.highcharts-point:hover</code> rule.</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/column-states-hover-brightness/\" target=\"_blank\">Brighten by 0.5</a>","deprecated":false,"fullname":"plotOptions.treemap.states.hover.brightness","title":"brightness","parent":"plotOptions-treemap-states-hover","isParent":false,"products":[],"defaults":"0.1"},{"name":"plotOptions-bubble","returnType":"Object","since":"3.0","description":"A bubble series is a three dimensional series type where each point renders an X, Y and Z value. Each points is drawn as a bubble where the position along the X and Y axes mark the X and Y values, and the size of the bubble relates to the Z value.","demo":"","deprecated":false,"fullname":"plotOptions.bubble","title":"bubble","parent":"plotOptions","isParent":true,"products":[],"defaults":"","values":"","seeAlso":""},{"name":"navigation-buttonOptions","description":"<p>A collection of options for buttons appearing in the exporting module.</p>\r\n\r\n<p>In <a href=\"http://www.highcharts.com/docs/chart-design-and-style/style-by-css\">styled mode</a>, the buttons are styled with the <code>.highcharts-contextbutton</code> and <code>.highcharts-button-symbol</code> class.</p>","deprecated":false,"fullname":"navigation.buttonOptions","title":"buttonOptions","parent":"navigation","isParent":true,"products":[]},{"name":"exporting-buttons","description":"Options for the export related buttons, print and export. In addition to the default buttons listed here, custom buttons can be added. See <a href=\"#navigation.buttonOptions\">navigation.buttonOptions</a> for general options.","deprecated":false,"fullname":"exporting.buttons","title":"buttons","parent":"exporting","isParent":true,"products":[]},{"name":"responsive-rules-condition--callback","returnType":"Function","since":"5.0.0","description":"A callback function to gain complete control on when the responsive rule applies. Return <code>true</code> if it applies. This opens for checking against other metrics than the chart size, or example the document size or other elements.","demo":"","deprecated":false,"fullname":"responsive.rules.condition.callback","title":"callback","parent":"responsive-rules-condition","isParent":false,"products":[],"context":"Chart","defaults":"","values":"","seeAlso":""},{"name":"global--canvasToolsURL","returnType":"String","description":"<p><em>Canvg rendering for Android 2.x is removed as of Highcharts 5.0. Use the <a href=\"#exporting.libURL\">libURL</a> option to configure exporting.</em></p>\r\n\r\n<p>The URL to the additional file to lazy load for Android 2.x devices. These devices don't \r\n support SVG, so we download a helper file that contains <a href=\"http://code.google.com/p/canvg/\">canvg</a>,\r\n its dependency rbcolor, and our own CanVG Renderer class. To avoid hotlinking to our site,\r\n you can install canvas-tools.js on your own server and change this option accordingly.</p>","deprecated":true,"fullname":"global.canvasToolsURL","title":"canvasToolsURL","parent":"global","isParent":false,"products":[],"defaults":"http://code.highcharts.com/{version}/modules/canvas-tools.js"},{"name":"yAxis--categories","returnType":"Array<String>","description":"<p>If categories are present for the xAxis, names are used instead of numbers for that axis. Since Highcharts 3.0, categories can also be extracted by giving each point a <a href=\"#series.data\">name</a> and setting axis <a href=\"#xAxis.type\">type</a> to <code>category</code>. However, if you have multiple series, best practice remains defining the <code>categories</code> array.</p>\r\n\r\n<p>Example:\r\n<pre>categories: ['Apples', 'Bananas', 'Oranges']</pre>\r\n\t\t Defaults to <code>null</code>\r\n</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/chart/reflow-true/\" target=\"_blank\">With</a> and\r\n\t\t\t<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/xaxis/categories/\" target=\"_blank\">without</a> categories","deprecated":false,"fullname":"yAxis.categories","title":"categories","parent":"yAxis","isParent":false,"products":[]},{"name":"zAxis--categories","returnType":"Array<String>","description":"<p>If categories are present for the xAxis, names are used instead of numbers for that axis. Since Highcharts 3.0, categories can also be extracted by giving each point a <a href=\"#series.data\">name</a> and setting axis <a href=\"#xAxis.type\">type</a> to <code>category</code>. However, if you have multiple series, best practice remains defining the <code>categories</code> array.</p>\r\n\r\n<p>Example:\r\n<pre>categories: ['Apples', 'Bananas', 'Oranges']</pre>\r\n\t\t Defaults to <code>null</code>\r\n</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/chart/reflow-true/\" target=\"_blank\">With</a> and\r\n\t\t\t<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/xaxis/categories/\" target=\"_blank\">without</a> categories","deprecated":false,"fullname":"zAxis.categories","title":"categories","parent":"zAxis","isParent":false,"products":[]},{"name":"xAxis--categories","returnType":"Array<String>","description":"<p>If categories are present for the xAxis, names are used instead of numbers for that axis. Since Highcharts 3.0, categories can also be extracted by giving each point a <a href=\"#series.data\">name</a> and setting axis <a href=\"#xAxis.type\">type</a> to <code>category</code>. However, if you have multiple series, best practice remains defining the <code>categories</code> array.</p>\r\n\r\n<p>Example:\r\n<pre>categories: ['Apples', 'Bananas', 'Oranges']</pre>\r\n\t\t Defaults to <code>null</code>\r\n</p>","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/chart/reflow-true/\" target=\"_blank\">With</a> and\r\n\t\t\t<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/xaxis/categories/\" target=\"_blank\">without</a> categories","deprecated":false,"fullname":"xAxis.categories","title":"categories","parent":"xAxis","isParent":false,"products":[]},{"name":"xAxis--ceiling","returnType":"Number","since":"4.0","description":"The highest allowed value for automatically computed axis extremes.","demo":" <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/yaxis/floor-ceiling/\" target=\"_blank\">Floor and ceiling</a>","deprecated":false,"fullname":"xAxis.ceiling","title":"ceiling","parent":"xAxis","isParent":false,"products":[],"defaults":"","values":"","seeAlso":"<a href=\"#xAxis.floor\">floor</a>"},{"name":"yAxis--ceiling","returnType":"Number","since":"4.0","description":"The highest allowed value for automatically computed axis extremes.","demo":" <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/yaxis/floor-ceiling/\" target=\"_blank\">Floor and ceiling</a>","deprecated":false,"fullname":"yAxis.ceiling","title":"ceiling","parent":"yAxis","isParent":false,"products":[],"defaults":"","values":"","seeAlso":"<a href=\"#xAxis.floor\">floor</a>"},{"name":"zAxis--ceiling","returnType":"Number","since":"4.0","description":"The highest allowed value for automatically computed axis extremes.","demo":" <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/yaxis/floor-ceiling/\" target=\"_blank\">Floor and ceiling</a>","deprecated":false,"fullname":"zAxis.ceiling","title":"ceiling","parent":"zAxis","isParent":false,"products":[],"defaults":"","values":"","seeAlso":"<a href=\"#xAxis.floor\">floor</a>"},{"name":"pane--center","returnType":"Array<String|Number>","since":"2.3.0","description":"The center of a polar chart or angular gauge, given as an array of [x, y] positions. Positions can be given as integers that transform to pixels, or as percentages of the plot area size.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/demo/gauge-vu-meter/\" target=\"_blank\">Two gauges with different center</a>","deprecated":false,"fullname":"pane.center","title":"center","parent":"pane","isParent":false,"products":[],"defaults":"[\"50%\", \"50%\"]"},{"name":"plotOptions-pie--center","returnType":"Array<String|Number>","description":"The center of the pie chart relative to the plot area. Can be percentages or pixel values. The default behaviour (as of 3.0) is to center the pie so that all slices and data labels are within the plot area. As a consequence, the pie may actually jump around in a chart with dynamic values, as the data labels move. In that case, the center should be explicitly set, for example to <code>[\"50%\", \"50%\"]</code>.\r\n\t\t ","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/pie-center/\" target=\"_blank\">Centered at 100, 100</a>","deprecated":false,"fullname":"plotOptions.pie.center","title":"center","parent":"plotOptions-pie","isParent":false,"products":[],"defaults":"[null, null]"},{"name":"series<pyramid>--center","returnType":"Array<String|Number>","since":"3.0","description":"The center of the series. By default, it is centered in the middle of the plot area, so it fills the plot area height.","deprecated":false,"fullname":"series<pyramid>.center","title":"center","parent":"series<pyramid>","isParent":false,"products":[],"defaults":"[\"50%\", \"50%\"]"},{"name":"series<pie>--center","returnType":"Array<String|Number>","description":"The center of the pie chart relative to the plot area. Can be percentages or pixel values. The default behaviour (as of 3.0) is to center the pie so that all slices and data labels are within the plot area. As a consequence, the pie may actually jump around in a chart with dynamic values, as the data labels move. In that case, the center should be explicitly set, for example to <code>[\"50%\", \"50%\"]</code>.\r\n\t\t ","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/pie-center/\" target=\"_blank\">Centered at 100, 100</a>","deprecated":false,"fullname":"series<pie>.center","title":"center","parent":"series<pie>","isParent":false,"products":[],"defaults":"[null, null]"},{"name":"series<funnel>--center","returnType":"Array<String|Number>","since":"3.0","description":"The center of the series. By default, it is centered in the middle of the plot area, so it fills the plot area height.","deprecated":false,"fullname":"series<funnel>.center","title":"center","parent":"series<funnel>","isParent":false,"products":[],"defaults":"[\"50%\", \"50%\"]"},{"name":"plotOptions-pyramid--center","returnType":"Array<String|Number>","since":"3.0","description":"The center of the series. By default, it is centered in the middle of the plot area, so it fills the plot area height.","deprecated":false,"fullname":"plotOptions.pyramid.center","title":"center","parent":"plotOptions-pyramid","isParent":false,"products":[],"defaults":"[\"50%\", \"50%\"]"},{"name":"plotOptions-funnel--center","returnType":"Array<String|Number>","since":"3.0","description":"The center of the series. By default, it is centered in the middle of the plot area, so it fills the plot area height.","deprecated":false,"fullname":"plotOptions.funnel.center","title":"center","parent":"plotOptions-funnel","isParent":false,"products":[],"defaults":"[\"50%\", \"50%\"]"},{"name":"chart","description":"Options regarding the chart area and plot area as well as general chart options.","fullname":"chart","title":"chart","isParent":true,"products":["highstock","highmaps","highcharts-ios"]},{"name":"responsive-rules--chartOptions","returnType":"Object","since":"5.0.0","description":"<p>A full set of chart options to apply as overrides to the general chart options. The chart options are applied when the given rule is active.</p>\r\n\r\n<p>A special case is configuration objects that take arrays, for example <a href=\"#xAxis\">xAxis</a>, <a href=\"#yAxis\">yAxis</a> or <a href=\"#series\">series</a>. For these collections, an <code>id</code> option is used to map the new option set to an existing object. If an existing object of the same id is not found, the item of the same indexupdated. So for example, setting <code>chartOptions</code> with two series items without an <code>id</code>, will cause the existing chart's two series to be updated with respective options.</p>","demo":"Chart options overrides for <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/responsive/axis/\" target=\"_blank\">axis</a>, <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/responsive/legend/\" target=\"_blank\">legend</a> and <a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/responsive/classname/\" target=\"_blank\">class name</a>.","deprecated":false,"fullname":"responsive.rules.chartOptions","title":"chartOptions","parent":"responsive-rules","isParent":false,"products":[]},{"name":"exporting--chartOptions","returnType":"Object","description":"Additional chart options to be merged into an exported chart. For example, a common use case is to add data labels to improve readaility of the exported chart, or to add a printer-friendly color scheme.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/exporting/chartoptions-data-labels/\" target=\"_blank\">Added data labels</a>.","deprecated":false,"fullname":"exporting.chartOptions","title":"chartOptions","parent":"exporting","isParent":false,"products":[],"defaults":"null"},{"name":"plotOptions-series-events--checkboxClick","returnType":"Function","since":"1.2.0","description":"Fires when the checkbox next to the series' name in the legend is clicked. One parameter, <code>event</code>, is passed to the function. The state of the checkbox is found by <code>event.checked</code>. The checked item is found by <code>event.item</code>. Return <code>false</code> to prevent the default action which is to toggle the select state of the series.","demo":"<a href=\"http://jsfiddle.net/gh/get/library/pure/highcharts/highcharts/tree/master/samples/highcharts/plotoptions/series-events-checkboxclick/\" target=\"_blank\">Alert checkbox status</a>","deprecated":false,"fullname":"plotOptions.series.events.checkboxClick","title":"checkboxClick","parent":"plotOptions-series-events","isParent":false,"products":[],"context":"Series"},{"name":"plotOptions-boxplot-events--checkboxClick","returnType":"Function","since":"1.2.0","description":"Fires when the checkbox next to t